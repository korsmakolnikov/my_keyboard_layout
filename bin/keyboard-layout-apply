#!/bin/bash
# Compiles the "us" layout with ~/.xkb ahead of the system XKB directory and
# loads it into the X server. setxkbmap keeps the model and the options
# already set on the server (e.g. ctrl:swapcaps), so they survive.
set -euo pipefail

: "${DISPLAY:?DISPLAY is not set}"

setxkbmap -layout us -print | xkbcomp -w0 -I"$HOME/.xkb" - "$DISPLAY"
